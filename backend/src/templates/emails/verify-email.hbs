<!doctype html><html><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Verify your email</title>
<style>body{margin:0;padding:0;background:#F5EFE1;font-family:Georgia,'Cormorant Garamond',serif;color:#1A1611;}.wrap{max-width:600px;margin:0 auto;padding:40px 24px;}.card{background:#FFFAF0;border:1px solid #E8D9B0;border-radius:16px;padding:36px;}.brand{text-align:center;font-size:12px;letter-spacing:.35em;color:#B98A2E;text-transform:uppercase;}h1{font-family:'Playfair Display',Georgia,serif;font-size:32px;color:#1A1611;margin:16px 0 8px;text-align:center;}p{font-size:15px;line-height:1.7;color:#4A3F2A;}.btn{display:inline-block;padding:14px 28px;background:#1A1611;color:#FFFAF0!important;text-decoration:none;border-radius:999px;letter-spacing:.16em;text-transform:uppercase;font-size:12px;font-weight:600;}.btn-wrap{text-align:center;margin:28px 0;}.foot{text-align:center;font-size:11px;color:#8C7B57;margin-top:32px;letter-spacing:.12em;text-transform:uppercase;}.line{border-top:1px solid #E8D9B0;margin:24px 0;}</style></head>
<body><div class="wrap"><p class="brand">{{brandName}}</p><div class="card"><h1>Almost there, {{name}}.</h1><p>Welcome to Bhavita Textiles. Please confirm your email to secure your account and start browsing our atelier.</p><div class="btn-wrap"><a class="btn" href="{{verifyUrl}}">Verify email</a></div><p>This link expires in 30 minutes and can only be used once.</p></div><p class="foot">Bhavita Textiles · {{appUrl}}</p></div></body></html>
