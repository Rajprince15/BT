# ---------- runtime ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api
FRONTEND_ORIGINS=http://localhost:3000

# ---------- database (MySQL 8.0) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bhavita_textiles
DB_USER=bhavita
DB_PASS=change-me

# ---------- auth ----------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ---------- cookies ----------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REACT_APP_RAZORPAY_ENABLED=false

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- email ----------
EMAIL_PROVIDER=smtp
EMAIL_FROM="Bhavita Textiles <no-reply@bhavitatextiles.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# ---------- monitoring ----------
SENTRY_DSN=
LOG_LEVEL=info

# ---------- rate limiting ----------
RATE_LIMIT_AUTH_PER_15MIN=5
RATE_LIMIT_PUBLIC_FORM_PER_HOUR=10
RATE_LIMIT_PUBLIC_READ_PER_MIN=120
RATE_LIMIT_AUTH_READ_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=600

# ---------- recaptcha (optional) ----------
RECAPTCHA_SECRET=


